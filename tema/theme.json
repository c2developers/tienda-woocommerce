{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "base", "name": "Crema", "color": "#F6F0E7" },
				{ "slug": "base-2", "name": "Papel", "color": "#FCF9F4" },
				{ "slug": "contrast", "name": "Espresso", "color": "#1E1612" },
				{ "slug": "contrast-2", "name": "Tueste", "color": "#5A3A2A" },
				{ "slug": "accent", "name": "Terracota", "color": "#C2562C" },
				{ "slug": "accent-2", "name": "Salvia", "color": "#7F8E6F" },
				{ "slug": "muted", "name": "Arena", "color": "#E9DFD0" },
				{ "slug": "line", "name": "Línea", "color": "#D9CBB8" }
			]
		},
		"layout": { "contentSize": "720px", "wideSize": "1280px" },
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "20", "name": "XS", "size": "0.5rem" },
				{ "slug": "30", "name": "S", "size": "1rem" },
				{ "slug": "40", "name": "M", "size": "clamp(1.25rem, 2vw, 1.75rem)" },
				{ "slug": "50", "name": "L", "size": "clamp(2rem, 4vw, 3rem)" },
				{ "slug": "60", "name": "XL", "size": "clamp(3rem, 7vw, 6rem)" },
				{ "slug": "70", "name": "XXL", "size": "clamp(4rem, 10vw, 9rem)" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "display", "name": "Fraunces",
					"fontFamily": "Fraunces, Georgia, serif",
					"fontFace": [
						{ "fontFamily": "Fraunces", "fontStyle": "normal", "fontWeight": "300 700", "fontDisplay": "swap", "src": ["file:./assets/fonts/fraunces-normal.woff2"] },
						{ "fontFamily": "Fraunces", "fontStyle": "italic", "fontWeight": "300 700", "fontDisplay": "swap", "src": ["file:./assets/fonts/fraunces-italic.woff2"] }
					]
				},
				{
					"slug": "body", "name": "Inter",
					"fontFamily": "Inter, system-ui, -apple-system, sans-serif",
					"fontFace": [
						{ "fontFamily": "Inter", "fontStyle": "normal", "fontWeight": "400 700", "fontDisplay": "swap", "src": ["file:./assets/fonts/inter-normal.woff2"] }
					]
				}
			],
			"fontSizes": [
				{ "slug": "x-small", "name": "XS", "size": "0.8125rem", "fluid": false },
				{ "slug": "small", "name": "S", "size": "0.9375rem", "fluid": false },
				{ "slug": "medium", "name": "M", "size": "1.0625rem", "fluid": { "min": "1rem", "max": "1.0625rem" } },
				{ "slug": "large", "name": "L", "size": "1.375rem", "fluid": { "min": "1.2rem", "max": "1.375rem" } },
				{ "slug": "x-large", "name": "XL", "size": "2rem", "fluid": { "min": "1.6rem", "max": "2rem" } },
				{ "slug": "xx-large", "name": "XXL", "size": "3.25rem", "fluid": { "min": "2.3rem", "max": "3.25rem" } },
				{ "slug": "huge", "name": "Enorme", "size": "5.25rem", "fluid": { "min": "3rem", "max": "5.25rem" } }
			]
		}
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--contrast)" },
		"spacing": { "blockGap": "1.25rem", "padding": { "left": "var(--wp--preset--spacing--40)", "right": "var(--wp--preset--spacing--40)" } },
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6",
			"letterSpacing": "-0.005em"
		},
		"elements": {
			"heading": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "420", "lineHeight": "1.08", "letterSpacing": "-0.02em" },
				"color": { "text": "var(--wp--preset--color--contrast)" }
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--huge)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h4": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
			"link": {
				"color": { "text": "var(--wp--preset--color--contrast)" },
				"typography": { "textDecoration": "underline" },
				":hover": { "color": { "text": "var(--wp--preset--color--accent)" } }
			},
			"button": {
				"color": { "background": "var(--wp--preset--color--contrast)", "text": "var(--wp--preset--color--base-2)" },
				"border": { "radius": "999px" },
				"spacing": { "padding": { "top": "0.85rem", "bottom": "0.85rem", "left": "1.6rem", "right": "1.6rem" } },
				"typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "var(--wp--preset--font-size--small)", "fontWeight": "600", "letterSpacing": "0.01em" },
				":hover": { "color": { "background": "var(--wp--preset--color--accent)", "text": "var(--wp--preset--color--base-2)" } },
				":focus": { "color": { "background": "var(--wp--preset--color--accent)", "text": "var(--wp--preset--color--base-2)" } }
			},
			"caption": { "typography": { "fontSize": "var(--wp--preset--font-size--x-small)" }, "color": { "text": "var(--wp--preset--color--contrast-2)" } }
		},
		"blocks": {
			"core/site-title": { "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontSize": "1.75rem", "fontWeight": "500", "letterSpacing": "-0.02em" } },
			"core/navigation": { "typography": { "fontSize": "var(--wp--preset--font-size--small)", "fontWeight": "500" } },
			"core/separator": { "color": { "text": "var(--wp--preset--color--line)" } },
			"core/post-title": { "typography": { "fontWeight": "420" } },
			"woocommerce/product-price": { "typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontWeight": "600" } },
			"core/post-terms": { "typography": { "fontSize": "var(--wp--preset--font-size--x-small)", "textTransform": "uppercase", "letterSpacing": "0.08em" } }
		}
	}
}
