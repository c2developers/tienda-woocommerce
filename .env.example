# Copia este fichero a .env y rellénalo. .env NO se sube a git.

# Dónde vive la tienda (con el túnel de Cloudflare, tu subdominio con https)
SITIO_URL=https://tienda.tudominio.com
PUERTO=8080

# La tienda
TEMA=tostela
TIENDA_NOMBRE=Tostela
TIENDA_LEMA="Café de especialidad tostado cada semana"
TIENDA_DIRECCION="Calle del Tueste 12"
TIENDA_CIUDAD=Madrid
TIENDA_CP=28012
IVA_CAFE=10

# El administrador (la contraseña la genera instalar.sh y la apunta aquí)
WP_ADMIN_USER=admin
WP_ADMIN_EMAIL=tu@correo.com

# Base de datos: pon dos contraseñas largas (openssl rand -hex 16)
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Correo por Resend: una API key y un remitente de un dominio verificado en Resend
RESEND_API_KEY=
CORREO_REMITENTE=tienda@tudominio.com

# Imágenes con IA (scripts/imagenes.py): una clave de la API de Gemini
GEMINI_API_KEY=
